                "exec": [
                  "// Generate random email to avoid duplicate key conflict on consecutive runs",
                  "const randomNum = Math.floor(Math.random() * 1000000);",
                  "const dynamicEmail = `user_${randomNum}@example.com`;",
                  "pm.collectionVariables.set(\"user_email\", dynamicEmail);"
