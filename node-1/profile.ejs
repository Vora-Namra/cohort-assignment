<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-black text-white">

  <!-- COVER -->
  <div class="relative">
    <img id="coverPic" class="w-full h-48 object-cover" />

    <!-- PROFILE PIC -->
    <div class="absolute -bottom-12 left-6">
      <img id="profilePic" class="w-24 h-24 rounded-full border-4 border-black object-cover" />
    </div>
  </div>

  <!-- INFO -->
  <div class="mt-16 px-6">

    <h2 id="name" class="text-2xl font-bold"></h2>
    <p id="username" class="text-gray-400"></p>

    <p id="bio" class="mt-3"></p>

    <div class="mt-4 text-gray-400 text-sm space-y-1">
      <p id="email"></p>
      <p id="dob"></p>
      <p id="timezone"></p>
    </div>

    <button 
      onclick="toggleEdit()"
      class="mt-4 px-4 py-2 border border-gray-600 rounded-full hover:bg-gray-800"
    >
      Edit Profile
    </button>

  </div>

  <!-- EDIT FORM -->
  <div id="editForm" class="hidden mt-10 px-6 pb-10">
    <form class="space-y-4 max-w-xl">

      <input id="inputUsername" type="text" class="w-full p-3 bg-black border border-gray-700 rounded" />
      <input id="inputEmail" type="email" class="w-full p-3 bg-black border border-gray-700 rounded" />
      <input id="inputPassword" type="password" placeholder="New Password" class="w-full p-3 bg-black border border-gray-700 rounded" />

      <input id="inputFirstname" type="text" class="w-full p-3 bg-black border border-gray-700 rounded" />
      <input id="inputLastname" type="text" class="w-full p-3 bg-black border border-gray-700 rounded" />

      <textarea id="inputBio" class="w-full p-3 bg-black border border-gray-700 rounded"></textarea>

      <input id="inputDob" type="date" class="w-full p-3 bg-black border border-gray-700 rounded" />
      <input id="inputTimezone" type="text" class="w-full p-3 bg-black border border-gray-700 rounded" />

      <button class="bg-white text-black px-6 py-2 rounded-full">Save</button>

    </form>
  </div>

  <script>
    // 🔥 HARD-CODED DATA (simulate backend response)
    const user = {
      firstname: "Namra",
      lastname: "Vora",
      username: "namra_dev",
      email: "namra@gmail.com",
      bio: "Learning Full Stack 🚀",
      dob: "2000-01-01",
      timezone: "IST",
      profile_pic: "https://via.placeholder.com/150",
      cover_pic: "https://via.placeholder.com/800x200"
    };

    // 🔥 Populate UI
    function loadProfile() {
      document.getElementById("name").innerText = user.firstname + " " + user.lastname;
      document.getElementById("username").innerText = "@" + user.username;
      document.getElementById("bio").innerText = user.bio || "No bio added";

      document.getElementById("email").innerText = "Email: " + user.email;
      document.getElementById("dob").innerText = "DOB: " + (user.dob || "Not set");
      document.getElementById("timezone").innerText = "Timezone: " + (user.timezone || "Not set");

      document.getElementById("profilePic").src = user.profile_pic;
      document.getElementById("coverPic").src = user.cover_pic;

      // Fill form inputs
      document.getElementById("inputUsername").value = user.username;
      document.getElementById("inputEmail").value = user.email;
      document.getElementById("inputFirstname").value = user.firstname;
      document.getElementById("inputLastname").value = user.lastname;
      document.getElementById("inputBio").value = user.bio;
      document.getElementById("inputDob").value = user.dob;
      document.getElementById("inputTimezone").value = user.timezone;
    }

    function toggleEdit() {
      document.getElementById("editForm").classList.toggle("hidden");
    }

    // Load data on page load
    loadProfile();
  </script>

</body>
</html>